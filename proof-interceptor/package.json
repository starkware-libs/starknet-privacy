{
  "name": "@starkware-libs/proof-interceptor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "prettier --check src/ tests/ && eslint src/ tests/ && tsc --noEmit",
    "format": "prettier --write src/ tests/ && eslint --fix src/ tests/"
  },
  "dependencies": {
    "@starkware-libs/starknet-privacy-sdk": "file:../sdk",
    "lru-cache": "11.3.5",
    "prom-client": "15.1.3",
    "starknet": "9.4.2",
    "zod": "3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@google-cloud/functions-framework": "5.0.2",
    "@types/node": "22.19.17",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.2",
    "vitest": "3.2.4"
  }
}
